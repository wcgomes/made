{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_user_question|AskUserQuestion|AskQuestion",
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ask_user_question|AskUserQuestion|AskQuestion",
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ],
    "StopCancelled": [
      {
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt",
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bin/status.py", "timeout": 5 }
        ]
      }
    ]
  }
}
